{
  "name": "henine",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @henine/worker",
    "dev:web": "npm run dev --workspace @henine/web",
    "dev:admin": "npm run dev --workspace @henine/admin",
    "prebuild": "node scripts/doctor.mjs",
    "build": "npm run build --workspace @henine/web && npm run build --workspace @henine/admin && node scripts/assemble-dist.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:e2e": "playwright test",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "perf": "node scripts/perf-lab.cjs",
    "db:generate": "npm run generate --workspace @henine/db",
    "db:sql:local": "npm run sql:local --workspace @henine/worker --",
    "db:migrate:local": "npm run migrate:local --workspace @henine/worker",
    "db:seed:local": "npm run seed:local --workspace @henine/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "pretest": "node scripts/doctor.mjs",
    "test": "npm run test --workspaces --if-present && node --test \"scripts/lib/*.test.mjs\"",
    "admin:invite": "node scripts/admin-invite.mjs"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261006.1": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
