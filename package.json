{
  "name": "henine",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @henine/worker",
    "dev:web": "npm run dev --workspace @henine/web",
    "dev:admin": "npm run dev --workspace @henine/admin",
    "build": "npm run build --workspace @henine/web && npm run build --workspace @henine/admin && node scripts/assemble-dist.mjs",
    "deploy": "npm run build && npm run deploy --workspace @henine/worker",
    "db:generate": "npm run generate --workspace @henine/db",
    "db:migrate:local": "npm run migrate:local --workspace @henine/worker",
    "db:seed:local": "npm run seed:local --workspace @henine/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "admin:invite": "node scripts/admin-invite.mjs"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260930.2": true,
    "unrs-resolver@1.12.2": true
  }
}
