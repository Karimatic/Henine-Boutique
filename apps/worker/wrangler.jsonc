{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "henine-boutique",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Storefront (pre-rendered pages) + admin SPA, assembled by scripts/assemble-dist.mjs.
  // Static files are served free and never count against the Worker request/CPU limits.
  // Only these paths run the Worker first:
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/robots.txt",
      "/sitemap.xml",
      "/feeds/*",
      "/api/*",
      "/admin",
      "/admin/*",
      "/media/*",
      "/l/*",
      "/produit/*",
      "/c/*",
      "/p/*",
      "/collection/*",
      "/fr/produit/*",
      "/fr/c/*",
      "/fr/p/*",
      "/fr/collection/*"
    ]
  },
  // The shop's address: henineboutique.com (and www., which redirects to it). The old workers.dev
  // address stays on: its pages redirect to the domain, its API keeps answering (saved pages,
  // the Telegram webhook).
  "routes": [
    { "pattern": "henineboutique.com", "custom_domain": true },
    { "pattern": "www.henineboutique.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "henine-boutique-db",
      "database_id": "fd580fa9-10fc-4ee0-a64a-edd046116c37",
      // Local development keeps its own database (npm run dev), never the production one: this
      // id only names the local copy (.wrangler/state). Query it from the repo root with
      // `npm run db:sql:local -- "SELECT …"` (the team table is team_members).
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "henine-media"
    }
  ],
  // Live admin (new orders, alerts) over WebSockets. SQLite-backed Durable Objects are on the
  // free plan; hibernation keeps idle admin tabs at zero cost.
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "AdminHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AdminHub"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "RL_WRITE",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_LOOKUP",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RL_AUTH",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // shop-wide (not per visitor) budget of database writes from counters: visits, error
      // reports, saved checkouts. Past it they are skipped: the daily D1 write quota stays for orders
      "name": "RL_BEACON",
      "namespace_id": "1005",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      // each visitor's own share of those counters, checked first: one script can no longer
      // empty the shop-wide budget for everyone (a real visit sends a few per minute)
      "name": "RL_BEACON_IP",
      "namespace_id": "1006",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RL_AI",
      "namespace_id": "1004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  // Workers AI: the shop assistant's voice (free daily allocation; when it is used up the
  // assistant answers with its rules alone, nothing is billed on the free plan)
  "ai": {
    "binding": "AI"
  },
  // 21:00 Algiers = 20:00 UTC (Algeria has no DST)
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "*/30 * * * *",
      "0 20 * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://henineboutique.com",
    "MEDIA_ORIGIN": "",
    // "console": no email service, admins sign in with an authenticator app
    "MAIL_PROVIDER": "console",
    "MAIL_FROM": "Henine Boutique <no-reply@example.com>",
    // "off" = assistant without AI
    "ASSISTANT_MODEL": "@cf/google/gemma-4-26b-a4b-it"
  },
  // Workers Logs: every request is kept (3 days), so a customer's failed order can always be
  // found. The free plan includes 200,000 log lines a day, far above this shop's traffic; past
  // that, logs are dropped for the day, never billed.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}