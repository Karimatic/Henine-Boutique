{
  "name": "@henine/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "sql:local": "wrangler d1 execute DB --local --command",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "wrangler d1 execute DB --local --file ../../packages/db/seed/geo.sql && wrangler d1 execute DB --local --file ../../packages/db/seed/base.sql && wrangler d1 execute DB --local --file ../../packages/db/seed/demo.sql",
    "seed:remote": "wrangler d1 execute DB --remote --file ../../packages/db/seed/geo.sql && wrangler d1 execute DB --remote --file ../../packages/db/seed/base.sql",
    "types": "wrangler types --env-interface CloudflareBindings src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@henine/db": "*",
    "@henine/shared": "*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
